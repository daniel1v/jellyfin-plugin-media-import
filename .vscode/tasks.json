{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Media Import: build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Publish-Plugin.ps1"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Media Import: test",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Jellyfin.Plugin.MediaImport.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Media Import: deploy to test Jellyfin",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-TestPlugin.ps1",
        "-JellyfinDataDir",
        "${config:mediaImportTestDataDir}"
      ]
    }
  ]
}
